{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "NEXT_PUBLIC_AH_BROWSER_DEMO=1 next build && touch out/.nojekyll",
    "start": "next start",
    "lint": "eslint",
    "gen:api": "openapi-typescript ../../docs/openapi.json -o src/lib/api/schema.d.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "e2e:pages": "playwright test -c playwright.pages.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
